# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in the values.
# This ONE file configures the HubSpot app: its API, its dashboard and Prisma.
#
# Unlike ../ace and ../mst (one brand each), this deployment serves EVERY
# business that installs the app from HubSpot, from one database.
# `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/review_autoreply_hubspot_dev"

# ── Backend API ──────────────────────────────────────────────────────────
PORT=4020
# Public https URL of this API. Used for OAuth redirects, the widget script
# and HubSpot request signatures - it must be exactly what HubSpot calls.
API_PUBLIC_URL=http://localhost:4020
WEB_APP_URL=http://localhost:3120

# ── Dashboard ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ is visible in the browser — never put a secret behind it.
NEXT_PUBLIC_API_URL=http://localhost:4020
# Shows a "Dev sign-in" button on the login page (development only).
NEXT_PUBLIC_DEV_LOGIN=false

# ── Sessions ─────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── OAuth token encryption (Google + HubSpot) ────────────────────────────
# Generate with: openssl rand -base64 32
# Losing this makes every stored token unreadable.
TOKEN_ENCRYPTION_KEY=

# ── HubSpot public app ───────────────────────────────────────────────────
# From the app in your HubSpot developer account (Auth tab).
HUBSPOT_CLIENT_ID=placeholder
HUBSPOT_CLIENT_SECRET=placeholder
# Must exactly match a redirect URL in hubspot-project/src/app/app-hsmeta.json.
HUBSPOT_OAUTH_REDIRECT_URI=http://localhost:4020/hubspot/oauth/callback
# Must match requiredScopes in app-hsmeta.json (space-separated).
HUBSPOT_SCOPES="oauth crm.objects.contacts.read crm.objects.contacts.write crm.schemas.contacts.read crm.schemas.contacts.write"
HUBSPOT_OPTIONAL_SCOPES=

# ── Google Business Profile ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4020/platform-accounts/google/callback

# ── Billing (Stripe) ─────────────────────────────────────────────────────
# Leave blank (or BILLING_ENFORCED=false) and every business is treated as paid.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# A recurring monthly Price; quantity = number of synced locations.
STRIPE_PRICE_ID=
STRIPE_TRIAL_DAYS=0
BILLING_ENFORCED=false
BILLING_GRACE_DAYS=7

# ── Review sync + posting ────────────────────────────────────────────────
REVIEW_SYNC_ENABLED=false
REVIEW_SYNC_INTERVAL_MIN=15
# Platform-wide master switch for posting to Google. Each business must ALSO
# switch auto-replies on (with consent) in its own Settings.
AUTO_POST_ENABLED=false

# ── Notifications ────────────────────────────────────────────────────────
# SMTP sends every business's approval emails. Recipients and Slack webhooks
# are set per business in Settings. ALERT_EMAIL_TO is only a fallback.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Review Auto-Reply <noreply@example.com>"
ALERT_EMAIL_TO=

# ── Local development ────────────────────────────────────────────────────
# Lets you sign in as the seeded demo business without HubSpot.
DEV_LOGIN_ENABLED=false

# ── AI provider (optional; drafting is template-based) ───────────────────
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Monitoring ───────────────────────────────────────────────────────────
SENTRY_DSN=
