# ─────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` in this same folder and fill in the values.
# This ONE file configures the ACE Training dashboard: its API, its web app and Prisma.
#
# Each brand is a separate deployment with its own domain and its own
# database. The other brand is configured in ../mst/.env.
#
# What each value is and where to get it: docs/CREDENTIALS.md
# `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Database ─────────────────────────────────────────────────────────────
# Used by both the API and the Prisma CLI (migrate / seed / studio).
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/review_autoreply_ace_dev"

# ── Backend API ──────────────────────────────────────────────────────────
PORT=4000
WEB_APP_URL=http://localhost:3100

# ── Dashboard ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_ is visible in the browser — never put a secret behind it.
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Redis (needed from build phase 6 onward) ─────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Staff login ──────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# ── Google OAuth token encryption ────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Losing this makes every stored Google token unreadable.
TOKEN_ENCRYPTION_KEY=

# ── Google Business Profile (build phase 5) ──────────────────────────────
# Placeholder values are fine until phase 5 — nothing calls Google yet.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/platform-accounts/google/callback

# ── AI provider (build phase 7) ──────────────────────────────────────────
# openai | anthropic | gemini — only the selected provider's key is needed.
AI_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ── Notifications (build phase 11) ───────────────────────────────────────
# Leave blank to disable that channel.
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_TO=
SMTP_FROM="AI Review Auto-Reply <noreply@example.com>"

# ── Monitoring (build phase 12) ──────────────────────────────────────────
SENTRY_DSN=

# ── Seed script only (`pnpm db:seed`) ────────────────────────────────────
# Becomes the first admin login for the dashboard.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=

# ── Read-only Google review sync ─────────────────────────────────────────
# When true, the backend polls connected Google accounts on a timer.
# Off by default. Manual sync (POST /platform-accounts/sync) works either way.
REVIEW_SYNC_ENABLED=false
REVIEW_SYNC_INTERVAL_MIN=15

# ── Posting replies back to Google (build phase: go-live) ────────────────
# Master switch for writing replies to Google. Off = draft-only (safe).
# When true: auto-postable drafts post after their rule delay, and manual
# approvals post to Google. Set true only at go-live (Birdeye switched off).
AUTO_POST_ENABLED=false
# Auto-post only reviews left on/after this date (the go-live date), so the
# historical backlog is never auto-replied. Blank = post backlog too.
AUTO_POST_MIN_REVIEW_DATE=
